---
/** Top jobs for one sex by headcount. Bar colour shows the job's overall gender mix. */
import { mixColor, type Sex } from "../../lib/charts";
import { occupations, fmtCount } from "../../lib/stats";
import { url } from "../../lib/url";

interface Props {
  sex: Sex;
  limit?: number;
}
const { sex, limit = 15 } = Astro.props;
const rows = [...occupations].sort((a, b) => b[sex] - a[sex]).slice(0, limit);
const max = rows[0][sex];
---

<ol class="bars">
  {
    rows.map((o, i) => (
      <li>
        <a href={url(`roles/${o.slug}`)} class="bar-row">
          <span class="rank mono">{i + 1}</span>
          <span class="name">{o.name}</span>
          <span class="track">
            <i style={`width:${(o[sex] / max) * 100}%; background:${mixColor(o.femalePct)}`}></i>
          </span>
          <span class="val mono">{fmtCount(o[sex])}</span>
          <span class="mix mono" title="Share of this job that is female">{o.femalePct.toFixed(0)}% F</span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .bar-row {
    display: grid; grid-template-columns: 22px minmax(150px, 230px) minmax(0, 1fr) 48px 50px;
    gap: 10px; align-items: center; text-decoration: none; padding: 4px 6px; margin-inline: -6px; border-radius: 4px;
  }
  .bar-row:hover { background: var(--panel); }
  .rank { font-size: 12px; color: var(--muted); text-align: right; }
  .name { font-family: var(--font-display); font-size: 14.5px; line-height: 1.2; overflow-wrap: anywhere; }
  .track { display: block; height: 18px; }
  .track i { display: block; height: 100%; border-radius: 2px; }
  .val { font-size: 13px; text-align: right; }
  .mix { font-size: 11.5px; color: var(--muted); text-align: right; }
  @media (max-width: 640px) {
    .bar-row { grid-template-columns: 18px minmax(0, 1fr) 44px 40px; row-gap: 4px; }
    .track { grid-column: 2 / -1; order: 5; height: 12px; }
  }
</style>
