---
interface Props {
  items: { big: string; text: string; tone?: "m" | "f" }[];
}
const { items } = Astro.props;
---

<dl class="facts" style={`--cols:${Math.min(items.length, 4)}`}>
  {
    items.map((it) => (
      <div>
        <dt class={`mono ${it.tone ?? ""}`}>{it.big}</dt>
        <dd>{it.text}</dd>
      </div>
    ))
  }
</dl>

<style>
  .facts { display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 12px; margin: 28px 0 0; padding: 0; }
  .facts div { background: var(--panel); border-radius: 8px; padding: 16px 18px; min-width: 0; }
  dt { font-size: 32px; font-weight: 500; line-height: 1.05; }
  dt.m { color: var(--male); }
  dt.f { color: var(--female); }
  dd { margin: 8px 0 0; font-size: 15px; line-height: 1.35; color: var(--muted); }
  @media (max-width: 820px) { .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 460px) { .facts { grid-template-columns: 1fr; } }
</style>
