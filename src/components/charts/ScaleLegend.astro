---
import { scaleStops } from "../../lib/charts";
const gradient = `linear-gradient(90deg, ${scaleStops.map((s) => `${s.c} ${s.p}%`).join(", ")})`;
---

<div class="legend" aria-label="Colour scale from 100% male in blue, through 50/50 in grey, to 100% female in red">
  <span class="bar" style={`background:${gradient}`}></span>
  <span class="labels"><span>100% male</span><span>50/50</span><span>100% female</span></span>
</div>

<style>
  .legend { display: grid; gap: 4px; width: min(320px, 100%); font-family: var(--font-display); }
  .bar { height: 10px; border-radius: 5px; display: block; }
  .labels { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); }
</style>
