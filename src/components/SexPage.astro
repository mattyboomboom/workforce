---
import Base from "../layouts/Base.astro";
import Figure from "./charts/Figure.astro";
import Facts from "./charts/Facts.astro";
import BarList from "./charts/BarList.astro";
import HundredRows from "./charts/HundredRows.astro";
import LeagueTable from "./charts/LeagueTable.astro";
import { totals, families, concentration, shareInJobsDominatedBy, crossover, type Sex } from "../lib/charts";
import { occupations, summary, fmtCount, fmtExact } from "../lib/stats";
import { url } from "../lib/url";

interface Props {
  sex: Sex;
}
const { sex } = Astro.props;
const other: Sex = sex === "men" ? "women" : "men";
const Label = sex === "men" ? "Men" : "Women";
const label = sex;
const tone = sex === "men" ? "m" : "f";
const own = (o: (typeof occupations)[number]) => (sex === "men" ? o.malePct : o.femalePct);
const pct = (v: number) => `${Math.round(v * 100)}%`;

const total = totals[sex];
const over90 = occupations.filter((o) => own(o) > 90);
const dom70 = shareInJobsDominatedBy(sex, 70);
const top10 = concentration(sex)[9];
const topJob = [...occupations].sort((a, b) => b[sex] - a[sex])[0];
const rarest = [...occupations].sort((a, b) => own(a) - own(b))[0];
const famSorted = [...families].sort((a, b) => b[sex] - a[sex]);
const topFam = famSorted[0];
const cross = crossover(sex);

const headline =
  sex === "men"
    ? "Men's jobs: spread out, but walled off"
    : "Women's jobs: fewer, bigger and more crowded";
const lede =
  sex === "men"
    ? `Men work across a wide range of mid-sized jobs, many of them almost entirely male. Here is where the ${fmtCount(total)} men on this chart work, what the most male jobs are, and where men are hardest to find.`
    : `Women are concentrated in a small number of very large occupations, mostly in care, education, retail and admin. Here is where the ${fmtCount(total)} women on this chart work, what the most female jobs are, and where women are hardest to find.`;
---

<Base
  title={`${Label} at Work · UK Jobs by Gender`}
  description={`Where ${fmtCount(total)} ${label} work across ${summary.count} UK jobs, with the most ${sex === "men" ? "male" : "female"} jobs and where ${label} are rarest.`}
>
  <header class="page-head">
    <p class={`eyebrow ${tone}`}>{Label} at work</p>
    <h1>{headline}</h1>
    <p class="lede">{lede}</p>
    <Facts
      items={[
        { big: fmtCount(total), text: `${label} in the ${summary.count} jobs shown`, tone },
        { big: String(over90.length), text: `jobs on the chart are over 90% ${sex === "men" ? "male" : "female"}`, tone },
        { big: pct(dom70), text: `of ${label} work in jobs that are at least 70% ${sex === "men" ? "male" : "female"}`, tone },
        { big: pct(top10), text: `of ${label} work in their ten biggest jobs`, tone },
      ]}
    />
  </header>

  <Figure
    kicker={`Where ${label} work`}
    title={`The 15 biggest employers of ${label}`}
    dek={`Ranked by the number of ${label} in each job. The top spot goes to ${topJob.name.toLowerCase()}, with ${fmtExact(topJob[sex])} ${label}. Bars are coloured by the gender mix of the whole job, so a red bar on this page means a job where most workers are women.`}
  >
    <BarList sex={sex} limit={15} />
  </Figure>

  <Figure
    kicker={`Of every 100 ${label}`}
    title={`${topFam.name} employs the most ${label}`}
    dek={`Each dot is one in every hundred ${label} on the chart, grouped by job family. ${topFam.name} accounts for ${fmtCount(topFam[sex])} ${label}.`}
    note="Job families are this site's own grouping of the jobs shown."
  >
    <HundredRows sexes={[sex]} />
  </Figure>

  <Figure
    kicker={`The most ${sex === "men" ? "male" : "female"} jobs`}
    title={`${over90.length} jobs are more than 90% ${label}`}
    dek={`The jobs where ${label} make up the largest share of the workforce, with the number of ${label} in each.`}
  >
    <LeagueTable sex={sex} order="most" limit={15} />
  </Figure>

  <Figure
    kicker={`Where ${label} are rarest`}
    title={`Only ${fmtExact(rarest[sex])} ${label} work as ${rarest.name.toLowerCase()}`}
    dek={`The jobs where ${label} make up the smallest share. Overall, ${fmtCount(cross)} ${label} work in jobs that are at least 70% ${other === "men" ? "male" : "female"}.`}
  >
    <LeagueTable sex={sex} order="least" limit={10} />
  </Figure>

  <nav class="next" aria-label="More summaries">
    <a href={url(other)} class={other === "men" ? "m" : "f"}>
      <span>Compare</span><b>{other === "men" ? "Men" : "Women"} at work ›</b>
    </a>
    <a href={url("everyone")}><span>Both together</span><b>Everyone at work ›</b></a>
  </nav>

  <p class="method">
    All figures cover the {summary.count} jobs on this site, {Math.round(summary.coveragePct)}% of the UK workforce, from
    Working Futures 2024.
  </p>
</Base>

<style>
  .eyebrow.m { color: var(--male); }
  .eyebrow.f { color: var(--female); }
  h1 { font-size: clamp(34px, 6vw, 58px); margin: 0 0 16px; max-width: 20ch; }
  .lede { font-size: 19px; max-width: 62ch; margin: 0; }
  .next { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 64px; }
  .next a {
    display: grid; gap: 2px; padding: 18px 20px; border-radius: 10px; text-decoration: none;
    border: 1px solid var(--line); background: var(--bg);
  }
  .next a:hover { border-color: var(--muted); }
  .next span { font-family: var(--font-display); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .next b { font-family: var(--font-display); font-size: 22px; }
  .next .m b { color: var(--male); }
  .next .f b { color: var(--female); }
  .method { margin-top: 28px; font-size: 14px; color: var(--muted); }
  @media (max-width: 560px) { .next { grid-template-columns: 1fr; } }
</style>
